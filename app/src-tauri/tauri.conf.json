{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude-Hydra",
  "version": "1.0.2",
  "identifier": "local.claude-hydra",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3017",
    "beforeDevCommand": "node scripts/fetch-mihomo.mjs && pnpm run dev:renderer",
    "beforeBuildCommand": "node scripts/fetch-mihomo.mjs && pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude-Hydra",
        "create": false,
        "decorations": false,
        "width": 860,
        "height": 560,
        "minWidth": 720,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mihomo"
    ],
    "resources": {
      "licenses/MIHOMO-LICENSE.txt": "licenses/MIHOMO-LICENSE.txt"
    },
    "category": "Utility",
    "shortDescription": "Claude-Hydra",
    "longDescription": "Run several Claude desktop accounts side by side.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5RjhBNjU5RTgwRDI3NjUKUldSbEp3M29XYWI0MllpTUdpb3FqVExQWFY3TmU3Q21QWGJjYk9GU0dXRTdLUlVtQVVBNklndVAK",
      "endpoints": [
        "https://github.com/jin-yu-liu/Claude-Hydra/releases/latest/download/latest.json"
      ]
    }
  }
}
