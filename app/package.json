{
  "name": "claude-hydra",
  "version": "1.1.2",
  "private": true,
  "description": "Claude-Hydra - run several Claude desktop accounts side by side",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "fetch:mihomo": "node scripts/fetch-mihomo.mjs",
    "test:rust": "node scripts/fetch-mihomo.mjs && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "marked": "^18.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.1"
  }
